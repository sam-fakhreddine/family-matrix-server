# Synapse configuration — rendered by setup.sh from templates/homeserver.yaml.tmpl.
# Don't hand-edit values that came from .env — change .env and re-run ./setup.sh --force.
#
# Posture: private, non-federating homeserver. The admin API is additionally
# blocked at Traefik for the public hostname; administer from the LAN.
server_name: "${MATRIX_HOST}"
pid_file: /data/homeserver.pid

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    # Explicit v4-only bind. In-container only — host exposure is governed by
    # the compose port mapping (LAN_HOST_IP). The synapse default ['::','0.0.0.0']
    # crash-loops on hosts with IPv6 disabled; traefik and the LAN mapping
    # both reach this container over IPv4.
    bind_addresses: ['0.0.0.0']
    resources:
      # client + openid ONLY — no federation resource, the federation API is
      # not served. openid is required: the call-auth service (lk-jwt)
      # validates user tokens via /_matrix/federation/v1/openid/userinfo.
      # Removing it breaks all calls with "unable to create room on SFU".
      - names: [client, openid]
        compress: false

database:
  name: psycopg2
  args:
    user: ${POSTGRES_USER}
    password: "${POSTGRES_PASSWORD}"
    database: ${POSTGRES_DB}
    host: db
    port: 5432
    cp_min: 5
    cp_max: 10

log_config: "/data/${MATRIX_HOST}.log.config"
media_store_path: /data/media_store
signing_key_path: "/data/${MATRIX_HOST}.signing.key"

registration_shared_secret: "${SYNAPSE_REGISTRATION_SECRET}"
macaroon_secret_key: "${SYNAPSE_MACAROON_KEY}"
form_secret: "${SYNAPSE_FORM_SECRET}"

# ── Hardening: closed private server ────────────────────────────────────────
report_stats: false
enable_registration: false
allow_guest_access: false
allow_public_rooms_without_auth: false
allow_public_rooms_over_federation: false
# Empty whitelist denies all federation — belt and suspenders with the
# missing federation listener resource above.
federation_domain_whitelist: []
trusted_key_servers: []
encryption_enabled_by_default_for_room_type: all
max_upload_size: 50M
# URL previews are an SSRF vector (the server fetches attacker-chosen URLs
# from inside the LAN). Off is the synapse default — pinned here so it
# survives config refactors. Element renders link previews fine without it.
url_preview_enabled: false
# Don't serve profile data (display name / avatar) to unauthenticated
# requests, and only to users who share a room — no directory scraping.
require_auth_for_profile_requests: true
limit_profile_requests_to_users_who_share_rooms: true
# A device untouched for a year is a lost/forgotten phone still holding a
# valid access token — expire it. The user just signs in again.
delete_stale_devices_after: 1y
# Synapse records each device's last-seen IP/user-agent in the database
# (default 28d). This is the metadata trail that outlives log rotation —
# keep the minimum the client API needs.
user_ips_max_age: 1d

# ── Calls: Element Call (MatrixRTC) ─────────────────────────────────────────
# serve_server_wellknown publishes {"m.server": "<server_name>:443"} — the
# call-auth service discovers the server through it. Required.
public_baseurl: "https://${MATRIX_HOST}/"
serve_server_wellknown: true
extra_well_known_client_content:
  "org.matrix.msc4143.rtc_foci":
    - type: "livekit"
      livekit_service_url: "https://${RTC_HOST}"
experimental_features:
  msc4222_enabled: true
  msc4143_enabled: true
matrix_rtc:
  transports:
    - type: livekit
      livekit_service_url: "https://${RTC_HOST}"
max_event_delay_duration: 24h
rc_message:
  per_second: 0.5
  burst_count: 30
rc_delayed_event_mgmt:
  per_second: 1
  burst_count: 20

# ── Legacy 1:1 TURN (Element Web/Desktop; Element X uses LiveKit) ───────────
turn_uris:
  - "turn:${TURN_HOST}:3478?transport=udp"
  - "turn:${TURN_HOST}:3478?transport=tcp"
turn_shared_secret: "${TURN_STATIC_SECRET}"
turn_user_lifetime: 86400000
turn_allow_guests: false

# family-matrix-server deployment parameters
# Copy to .env, fill in the Identity/Network sections, then run: ./setup.sh
# setup.sh generates the SECRETS section for you if the values are left empty.
# NEVER commit .env — it is gitignored for a reason.

# ── Identity ────────────────────────────────────────────────────────────────
# Your domain (must be on Cloudflare for the bundled ingress).
DOMAIN=example.com

# Public hostnames. MATRIX_HOST is also the Matrix server_name — it becomes
# part of every user ID (@alice:matrix.example.com) and CANNOT be changed
# after first start without resetting the server.
MATRIX_HOST=matrix.example.com
RTC_HOST=rtc.example.com          # call-auth service (lk-jwt), proxied via tunnel
LIVEKIT_HOST=livekit.example.com  # call signaling websocket, proxied via tunnel
TURN_HOST=turn.example.com        # TURN relay — DNS-only A record (NOT proxied)

# ── Network ─────────────────────────────────────────────────────────────────
# Your public IP (setup.sh can auto-detect). Calls need router port-forwards,
# so CGNAT connections (no real public IP) will not work for remote callers.
WAN_IP=

# LAN details. LAN_HOST_IP = the docker host's LAN address (admin UIs bind here).
LAN_HOST_IP=192.168.1.10
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# macvlan gives the media containers their own LAN IPs so router forwards hit
# them directly and LAN devices get switch-speed call media. Pick a small block
# OUTSIDE your DHCP pool and two IPs from it. MACVLAN_PARENT is the host's LAN
# interface (e.g. eth0, enp3s0, or a bridge like vmbr0 on Proxmox).
MACVLAN_PARENT=eth0
MACVLAN_RANGE=192.168.1.240/29
COTURN_IP=192.168.1.241
LIVEKIT_IP=192.168.1.242

# ── Ingress ─────────────────────────────────────────────────────────────────
# Using the bundled ingress/ stack: leave these defaults.
# Bringing your own Traefik: set TRAEFIK_NETWORK to its docker network and
# CERT_RESOLVER to your resolver's name, and skip the ingress/ directory.
TRAEFIK_NETWORK=family-matrix-ingress
CERT_RESOLVER=cloudflare

# Bundled ingress only: Cloudflare Tunnel token (dashboard → Zero Trust →
# Tunnels → create → copy token) and a DNS API token scoped to your zone
# (for Let's Encrypt DNS-01 certificates).
TUNNEL_TOKEN=
CF_DNS_API_TOKEN=

# ── Backups ─────────────────────────────────────────────────────────────────
# Nightly destination (setup.sh offers to install a cron entry).
BACKUP_DIR=/srv/backups/family-matrix-server

# ── Secrets ─────────────────────────────────────────────────────────────────
# Leave empty — setup.sh fills any blank value with a freshly generated secret.
# Rotation warning: TURN_STATIC_SECRET, LIVEKIT_API_SECRET, POSTGRES_PASSWORD
# and the SYNAPSE_* secrets are also rendered as literals into the generated
# configs (homeserver.yaml, turnserver.conf, livekit.yaml) — after changing
# one, re-run ./setup.sh --force and restart the affected services.
POSTGRES_USER=synapse
POSTGRES_DB=synapse
POSTGRES_PASSWORD=
TURN_STATIC_SECRET=
LIVEKIT_API_SECRET=
SYNAPSE_REGISTRATION_SECRET=
SYNAPSE_MACAROON_KEY=
SYNAPSE_FORM_SECRET=
